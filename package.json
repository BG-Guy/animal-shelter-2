{
  "name": "animal-shelter",
  "version": "0.1.0",
  "private": true,
  "description": "Portfolio project: a warm, friendly animal shelter website.",
  "scripts": {
    "build:html": "node ./scripts/build-html.js",
    "build:css": "tailwindcss -i ./src/css/input.css -o ./dist/output.css --minify",
    "build": "npm run build:html && npm run build:css",
    "watch:css": "tailwindcss -i ./src/css/input.css -o ./dist/output.css --watch",
    "start": "npx serve ."
  },
  "devDependencies": {
    "tailwindcss": "^3.4.13"
  }
}
